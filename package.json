{
  "name": "orbit-pm",
  "version": "1.0.0",
  "description": "Orbit - project management for small teams (Svelte + Node + PostgreSQL, deployable to Vercel)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm --prefix web install",
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/dev.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web install && npm --prefix web run build",
    "start": "node server/dev.js",
    "db:migrate": "node server/migrate.js",
    "db:seed": "node server/seed.js",
    "db:reseed": "node server/seed.js --force",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
